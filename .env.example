# ==============================================================================
# Smart Restaurant Management and Ordering System - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your actual local configuration.
# NEVER commit the actual '.env' file, secrets, or backups to version control.
# ==============================================================================

# =========================
# Flask Configuration
# =========================
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=generate_a_secure_random_key_here
SESSION_COOKIE_SECURE=false

# =========================
# MySQL Database Configuration
# =========================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_restaurant_db
DB_USER=smart_restaurant_app
DB_PASSWORD=your_secure_db_password_here

# =========================
# Location Coordinates (Trichy Center Default)
# =========================
TRICHY_LAT=10.7905
TRICHY_LNG=78.7047

# =========================
# External APIs (Optional)
# =========================
GOOGLE_MAPS_API_KEY=your_optional_google_maps_api_key_here